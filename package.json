{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Implementação do https://www.tabnews.com.br para o https://curso.dev",
  "main": "index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "npm run services:wait:database && npm run migrations:up && next dev",
    "test": "concurrently -n next,jest  -k -s command-jest \"next dev --webpack\" \"jest --runInBand\"",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate -m infra/migrations --envPath .env.development --dry-run up",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "lint:check": "npm run lint:eslint:check && npm run lint:prettier:check",
    "lint:eslint:check": "eslint .",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "Maycon",
  "license": "MIT",
  "dependencies": {
    "@typescript-eslint/parser": "8.59.2",
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "cookie": "1.1.1",
    "next": "16.2.5",
    "next-connect": "1.0.0",
    "node-pg-migrate": "7.6.1",
    "nodemailer": "8.0.7",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "swr": "2.4.1",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@faker-js/faker": "9.7.0",
    "commitizen": "4.3.1",
    "concurrently": "9.2.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.15.2",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "prettier": "3.8.3",
    "set-cookie-parser": "3.1.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
